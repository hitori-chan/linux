// SPDX-License-Identifier: GPL-2.0-only
/*
 * The M3 Max MacBook Pros (J514c, J514m, J516c, J516m): what their die has and the M3 Pro's lacks, beside
 * t603x-j514-j516.dtsi, which the M3 Pro's boards share.
 *
 * Copyright The Asahi Linux Contributors
 */

/ {
	aliases {
		sep = &sep;
	};
};

&spi2 {
	status = "okay";

	/*
	 * The Touch ID sensor (the ADT's `biosensor,mesa`), which the SEP drives through it: chip select 0, SPI mode 1;
	 * macOS runs 8 MHz, the lab 1 MHz. Its one power switch is nub pin 53 (7 ms after on, 10 ms after off), its
	 * interrupt AP pin 34, level high.
	 */
	touchid: sensor@0 {
		compatible = "apple,mesa";
		reg = <0>;
		spi-max-frequency = <1000000>;
		spi-cpha;
		enable-gpios = <&pinctrl_nub 53 GPIO_ACTIVE_HIGH>;
		irq-gpios = <&pinctrl_ap 34 GPIO_ACTIVE_HIGH>;
	};
};

/* Touch ID: the SEP driver's daily flow binds the SEP's node; m1n1 (r74 on) fills it through the `sep` alias. */
&sep_dart {
	status = "okay";
};

&sep_mbox {
	status = "okay";
};

&sep {
	status = "okay";
};
