config VIDEO_APPLE_JPEG
	tristate "Apple silicon JPEG decoder"
	depends on V4L_MEM2MEM_DRIVERS
	depends on ARCH_APPLE || COMPILE_TEST
	depends on VIDEO_DEV
	select VIDEOBUF2_DMA_CONTIG
	select V4L2_MEM2MEM_DEV
	select V4L2_JPEG_HELPER
	help
	  This is a V4L2 memory-to-memory driver for the JPEG codec of
	  Apple silicon SoCs, which decodes baseline JPEG to YUV and RGB.

	  To compile this driver as a module, choose M here: the module
	  will be called apple-jpeg.
